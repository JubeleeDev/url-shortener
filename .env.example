POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:port/${POSTGRES_DB}?sslmode=disable
GOOSE_MIGRATION_DIR=./directory